    "@fontsource/cormorant-garamond": "^5.0.0",
    "@fontsource/inter": "^5.0.0",
    "@ravenloft/shared": "*",
    "dompurify": "^3.2.0",
    "lucide-react": "^0.510.0",
    "marked": "^15.0.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-router-dom": "^7.0.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.4.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.0",
    "vite": "^7.3.5"
  }
