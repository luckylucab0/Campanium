{
  "name": "@ravenloft/client",
  "version": "1.0.0",
  "private": true,
  "description": "React-Frontend des Ravenloft Companion – DM-Modus (mit API) und Spieler-Modus (statisch).",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
